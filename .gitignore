# =============================================================================
# .gitignore —— 告诉 Git「哪些文件不要纳入版本管理」
#
# 判断标准：这个文件是不是「每台电脑上都不一样」或「能由代码重新生成」？
#   - 是 → 不要提交（比如数据库文件、密码密钥、缓存）
#   - 否 → 必须提交（比如源码、文档、配置）
# 提交了不该提交的文件，轻则仓库变脏，重则把私人数据传到公开的 GitHub 上。
#
# ⚠️ 重要语法提醒：本文件**不支持行尾注释**！
#   写 "__pycache__/   # 缓存" 会被 Git 当成"名字里带 # 号的文件"来匹配，
#   于是规则完全失效（本项目踩过这个坑）。注释必须**单独占一行**。
# =============================================================================

# ---------- Python 运行时产物 ----------

# Python 自动生成的字节码缓存
__pycache__/

# .pyc / .pyo / .pyd 等编译产物
*.py[cod]

# 打包时自动生成的元数据目录
*.egg-info/

# 打包输出目录
build/
dist/

# 虚拟环境（隔离依赖用，体积大且每台机器不同）
.venv/
venv/
env/

# ---------- 测试与检查工具产物 ----------

# pytest 的缓存（记录上次哪些用例失败）
.pytest_cache/

# ruff 的缓存（加速重复检查）
.ruff_cache/

# coverage 覆盖率数据文件
.coverage

# coverage 生成的 HTML 报告
htmlcov/

# ---------- 本地数据（重要：私人数据绝不入版本库）----------

# SQLite 数据库：你记录的真实问题都在里面
questions.db

# 其他 SQLite 数据库文件
*.db

# SQLite 回滚日志
*.db-journal

# SQLite 预写日志
*.db-wal

# SQLite 共享内存文件
*.db-shm

# 旧版 JSON 存储时代的损坏备份
questions.json.bak

# 数据库损坏时的自动备份
*.db.bak

# ---------- 运行时生成的密钥（泄露会导致会话被伪造）----------

# Flask 会话签名密钥
.flask_secret

# 密码哈希用的盐值
.auth_salt

# ---------- 运行时生成的目录与锁 ----------

# 备份文件目录（体积大，且是本机数据快照）
backups/

# CSV 导出目录
exports/

# 跨进程写锁文件
.data.lock

# 测试用的临时目录（测试运行完自动清理）
.tmp/

# ---------- 编辑器 / 系统垃圾文件 ----------

# 编辑器个人配置（每人不同，不入库）
.vscode/
.idea/

# Vim 交换文件
*.swp

# 编辑器备份文件
*~

# macOS 自动生成的目录信息文件
.DS_Store

# Windows 缩略图缓存
Thumbs.db

# ---------- 第三方工具产物 ----------

# Trae AI 工具生成的 HTML 分享包，与项目功能无关
.trae-html-share-packages/
